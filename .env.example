# Change this value, then set the same value in the EA's InpBridgeKey input.
MT5_BRIDGE_KEY=replace-with-a-long-random-local-key

# This URL is compiled into the browser bundle. Native services bind only to this computer.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5182

# Keep false through all backtest and demo stages. Real mode requires this and the EA input to be enabled.
ALLOW_REAL_CONTROL=false

# Optional. start-local.ps1 auto-detects the standard install; set this for a custom MT5 installation.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

